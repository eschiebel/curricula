{
  "name": "curricula",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "homepage": "https://eschiebel.github.io/curricula",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "format": "biome format --write src",
    "lint": "biome lint src",
    "check": "biome check src --config-path ../biome.json",
    "check:fix": "npm run check -- --write",
    "typecheck": "tsc --noEmit",
    "predeploy": "npm run check && npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "cytoscape": "^3.33.1",
    "ajv": "^8.17.1",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@preact/preset-vite": "^2.10.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "gh-pages": "^6.3.0",
    "jsdom": "^27.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.15"
  }
}
