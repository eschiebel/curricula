		"check": "biome check .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"cytoscape": "^3.33.1",
		"preact": "^10.27.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.8",
